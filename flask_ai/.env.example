# AgriLink Flask AI Environment Variables

# Google Gemini API Key
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=use_the_same_random_secret_as_the_node_backend
ALLOWED_ORIGINS=http://localhost:5173

# Optional: Port for Flask
# PORT=5001

# Use a shared Redis instance for multi-instance production deployments.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
